{
  "name": "annotatr",
  "version": "0.1.0",
  "description": "A second screen for coding-agent output: read a turn in the browser, annotate any range, ask a read-only sub-agent, carry back only your conclusions.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "annotatr": "bin/annotatr.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
